@echo off
set "ASKPASS_PROMPT=%~1"
pwsh -NoProfile -WindowStyle Hidden -Command "$prompt = if ($env:ASKPASS_PROMPT) { $env:ASKPASS_PROMPT } else { 'Enter SSH passphrase:' }; Add-Type -AssemblyName System.Windows.Forms; $form = New-Object Windows.Forms.Form; $form.Text = 'SSH Passphrase'; $form.Size = New-Object Drawing.Size(340,140); $form.StartPosition = 'CenterScreen'; $form.TopMost = $true; $form.FormBorderStyle = 'FixedDialog'; $form.MaximizeBox = $false; $form.MinimizeBox = $false; $lbl = New-Object Windows.Forms.Label; $lbl.Text = $prompt; $lbl.Location = New-Object Drawing.Point(10,10); $lbl.Size = New-Object Drawing.Size(310,20); $tb = New-Object Windows.Forms.MaskedTextBox; $tb.PasswordChar = [char]42; $tb.Location = New-Object Drawing.Point(10,36); $tb.Size = New-Object Drawing.Size(300,24); $btn = New-Object Windows.Forms.Button; $btn.Text = 'OK'; $btn.DialogResult = 'OK'; $btn.Location = New-Object Drawing.Point(130,68); $form.Controls.AddRange(@($lbl,$tb,$btn)); $form.AcceptButton = $btn; $r = $form.ShowDialog(); if ($r -ne 'OK') { exit 1 }; [Console]::Write($tb.Text)"
