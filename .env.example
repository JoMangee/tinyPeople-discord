# Discord bot token for REST API calls (never commit real value)
DISCORD_TOKEN=replace_with_new_discord_bot_token

# Shared secret required by the /messages endpoint.
# Send this in request header X-TinyPeople-Secret
TP_SHARED_SECRET=replace_with_long_random_secret

# Optional compatibility mode for clients that cannot set custom headers.
# When enabled, /messages also accepts tp_secret query param.
# Keep disabled unless needed because query strings may be logged upstream.
ALLOW_SECRET_QUERY_PARAM=0

# Optional troubleshooting mode. When enabled, clients can pass tp_debug=1
# to include non-secret upstream diagnostics in /messages responses.
ALLOW_DEBUG_QUERY_PARAM=0

# Simple digest compatibility mode for constrained clients.
# Client sends tp_digest (or X-TinyPeople-Digest) where digest is:
#   sha256("<TP_DIGEST_SALT>:<TP_SHARED_SECRET>")
# This avoids sending the raw secret but behaves like a bearer token.
# If your agent cannot hash at all, set TP_AGENT_DIGEST to a precomputed
# random value and have the agent send exactly that in tp_digest.
ALLOW_STATIC_DIGEST_QUERY_PARAM=1
TP_DIGEST_SALT=replace_with_random_salt
TP_AGENT_DIGEST=

# Stronger signed-request mode (timestamp + nonce + HMAC) for capable clients.
ALLOW_SIGNED_QUERY_PARAM=1
REQUIRE_SIGNED_AUTH=0
SIGNED_TIMESTAMP_TOLERANCE_SECONDS=300

# Optional comma-separated channel allowlist. Empty allows all channels the bot can read.
ALLOWED_CHANNEL_IDS=

# Channels any authenticated tenant may read without a per-tenant channel grant.
# Useful for shared/announcement channels. Comma-separated Discord channel IDs.
TP_PUBLIC_CHANNEL_IDS=

# Optional endpoint tuning
DEFAULT_MESSAGE_LIMIT=20
MAX_MESSAGE_LIMIT=50
DISCORD_HTTP_TIMEOUT_SECONDS=15
RAW_IMAGE_MODE_MAX_BYTES=786432
RAW_IMAGE_CHUNK_CHARS=12000
RAW_IMAGE_FETCH_TIMEOUT_SECONDS=15
RAW_IMAGE_MAX_ATTACHMENTS=3
METRICS_WINDOW_SECONDS=60
UNIQUE_HOST_WINDOW_SECONDS=300

# Build/revision overrides
POD_APP_REVISION=dev
POD_APP_BUILD=local

# cPanel/Passenger typically sets PORT automatically
PORT=8080

# Multi-tenant & API key settings (Phase 1: optional)
# Enable API key-based authentication with per-tenant isolation
TP_ENABLE_API_KEYS=0

# Rate limiting per API key (when TP_ENABLE_API_KEYS=1)
TP_RATE_LIMIT_PER_MINUTE=30
TP_RATE_LIMIT_WINDOW_SECONDS=60

# SQLite database location for multi-tenant data (relative to app root)
# Used for API keys, tenant grants, channel allowlists, rate limit tracking
TP_DB_PATH=var/tinypeople.db

# Discord OAuth install flow (Phase 2: optional)
# Create an app at https://discord.com/developers/applications
# Enable OAuth2, add redirect URI matching DISCORD_OAUTH_REDIRECT_URI below
TP_OAUTH_ENABLED=0
DISCORD_CLIENT_ID=replace_with_discord_application_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_application_client_secret
# Must match exactly what you set in Discord Developer Portal > OAuth2 > Redirects
DISCORD_OAUTH_REDIRECT_URI=https://your-domain/oauth/callback
# Discord application public key (Developer Portal -> General Information)
# Required for validating signed Discord interaction requests.
DISCORD_APP_PUBLIC_KEY=
# Set to 1 to enable HTTP interactions endpoint at /discord/interactions
DISCORD_INTERACTIONS_ENABLED=1
# Bot permissions integer: 66560 = View Channel (1024) + Read Message History (65536)
DISCORD_BOT_PERMISSIONS=66560
# Mention status reply worker endpoint (/discord/mentions/respond)
# Set DISCORD_BOT_USER_ID to avoid an extra /users/@me lookup on first run.
MENTION_REPLY_ENABLED=0
DISCORD_BOT_USER_ID=
MENTION_REPLY_SCAN_LIMIT=20
MENTION_REPLY_LOOKBACK_LIMIT=60
MENTION_ACTIVE_MIN_MESSAGES=3
MENTION_ACTIVE_WINDOW_SECONDS=3600
MENTION_REPLY_COOLDOWN_SECONDS=21600
MENTION_REPLY_MAX_RESPONSES_PER_RUN=1
# Show-once API key retrieval TTL after OAuth callback (seconds, clamped 60..3600)
TP_OAUTH_SHOW_ONCE_TTL_SECONDS=300
# OAuth state / pairing TTL before Discord callback returns (seconds, clamped 60..3600).
# Defaults to TP_OAUTH_SHOW_ONCE_TTL_SECONDS when unset.
TP_OAUTH_STATE_TTL_SECONDS=300

# Public-facing service identity (used in /terms and /privacy pages)
TP_SERVICE_NAME=tinyPeople Discord Messages API
TP_BASE_URL=https://your-domain
TP_CONTACT_EMAIL=

# Helper script defaults for ops/scripts/poll_mentions.sh
# The helper loads this .env automatically when present.
TP_KEY=
TP_DIGEST=
TP_AGENT_DIGEST=
TP_CHANNEL_ID=
TP_CHANNEL_IDS=
TP_SCAN_LIMIT=20
TP_LOOKBACK_LIMIT=60
TP_MAX_REPLIES=1
TP_OUTPUT_MODE=summary

# Multi-tenant & API key settings (Phase 1)
TP_ENABLE_API_KEYS=0
TP_RATE_LIMIT_PER_MINUTE=30
TP_RATE_LIMIT_WINDOW_SECONDS=60

# SQLite database location (relative to app root)
TP_DB_PATH=var/tinypeople.db
